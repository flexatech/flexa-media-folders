{
    "name": "flexatech/flexa-media-folders",
    "description": "Organize the WordPress Media Library into a hierarchical, drag-and-drop folder tree.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://flexa.vn",
    "authors": [
        {
            "name": "Flexa Tech",
            "homepage": "https://flexa.vn"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.3"
    },
    "autoload": {
        "psr-4": {
            "Flexa\\MediaFolders\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flexa\\MediaFolders\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "lint": "phpcs",
        "fix": "phpcbf",
        "analyse": "phpstan analyse"
    }
}
